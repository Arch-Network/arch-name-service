{
  "name": "@arch-network/ans-sdk",
  "version": "0.1.0-testnet.2",
  "description": "TypeScript SDK for Arch Name Service resolution and mutations",
  "publishConfig": {
    "access": "public",
    "tag": "testnet"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifests/testnet.json": "./manifests/testnet.json"
  },
  "files": [
    "dist",
    "manifests",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@saturnbtcio/arch-sdk": "^0.0.24",
    "bech32": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arch-Network/arch-name-service"
  }
}
